# Port for local Express/Vite fullstack server
PORT=3000

# Public Site URL (HTTPS in production)
PUBLIC_SITE_URL="https://michaelspeace.vercel.app"
VITE_PUBLIC_SITE_URL="https://michaelspeace.vercel.app"

# Supabase PostgreSQL Configuration
# Create a free project at https://supabase.com
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-public-key"
SUPABASE_SECRET_KEY="your-server-only-secret-key"

# Resend Transactional Email (Optional)
# Get your API key at https://resend.com
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="invitations@michealspeace.com"
# Inbox for new guestbook wishes (defaults to the couple's configured inbox)
WISHES_NOTIFICATION_EMAIL="michael.chukuwu.241426@unn.edu.ng"
# Web3Forms access key (preferred for wishes; keep server-only)
WEB3FORMS_ACCESS_KEY="your_web3forms_access_key"

# Local-only demonstration mode. Never enable this on Vercel.
LOCAL_DEMO="false"
LOCAL_ADMIN_EMAIL=""
LOCAL_ADMIN_PASSWORD=""
